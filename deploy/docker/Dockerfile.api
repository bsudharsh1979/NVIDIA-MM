FROM python:3.12-slim
WORKDIR /app
COPY services/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY services/api /app/api
COPY services/twin-engine /app/twin-engine
COPY course-materials /app/course-materials
ENV PYTHONPATH=/app/api:/app/twin-engine
ENV COURSE_MATERIALS_DIR=/app/course-materials
ENV DATABASE_URL=sqlite:////app/data/academy.db
WORKDIR /app/api
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
