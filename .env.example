# Core
DATABASE_URL=sqlite:///./data/academy.db
COURSE_MATERIALS_DIR=../../course-materials
API_HOST=0.0.0.0
API_PORT=8000
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Tutor engines — pick one in Settings. Leave blank to stay in offline Demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

NIM_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Voice (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SARVAM_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Research mode only
PERPLEXITY_API_KEY=

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Omniverse bridge (optional; not required for the web academy)
OMNIVERSE_BRIDGE_URL=ws://localhost:8010/twin
NVCF_API_KEY=

# Cost governance
MONTHLY_BUDGET_USD=25
DEFAULT_TUTOR_PROVIDER=demo
